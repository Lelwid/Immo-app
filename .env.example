NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GEOAPIFY_API_KEY=
OPENAI_API_KEY=
HABIXA_AI_MODEL=gpt-4.1-mini
HABIXA_COPILOT_MODEL=gpt-4.1-mini
OCR_PROVIDER=none
OCR_API_KEY=
OCR_ENDPOINT=
HABIXA_OCR_PROVIDER=none
HABIXA_OCR_API_KEY=
HABIXA_OCR_ENDPOINT=

# URL publique stable utilisée par le serveur pour construire les invitations.
HABIXA_APP_URL=http://localhost:3000

# Transport SMTP transactionnel fourni par le prestataire choisi.
HABIXA_SMTP_HOST=
HABIXA_SMTP_PORT=587
HABIXA_SMTP_SECURE=false
HABIXA_SMTP_USER=
HABIXA_SMTP_PASSWORD=
HABIXA_EMAIL_FROM=Habixa <no-reply@example.com>
